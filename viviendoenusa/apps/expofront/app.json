{
  "expo": {
    "name": "Viviendo en USA",
    "slug": "viviendoenusa",
    "version": "1.1.5",
    "scheme": "viviendoenusa",
    "orientation": "portrait",
    "icon": "./assets/images/backgroundusa.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/backgroundusa.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.viviendoenusa.expofront",
      "buildNumber": "24",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Viviendo en USA utiliza tu ubicación actual para calcular un radio de búsqueda de 20 millas y mostrarte recursos locales específicos, por ejemplo, encontrar oficinas de abogados de inmigración o ferias comunitarias cercanas a tu vecindario.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Viviendo en USA utiliza tu ubicación actual para calcular un radio de búsqueda de 20 millas y mostrarte recursos locales específicos, por ejemplo, encontrar oficinas de abogados de inmigración o ferias comunitarias cercanas a tu vecindario."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/backgroundusa.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.viviendoenusa.expofront",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAH9kMQE1MHpWtn6OZZoW71yu4qVocNAMI"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/backgroundusa.png",
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://viviendoenusa.app"
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/backgroundusa.png",
          "color": "#FF5F6D"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir a Viviendo en USA acceder a tus fotos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/backgroundusa.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "486f501f-ae6e-484d-92ab-5a9c40319e6f"
      }
    }
  }
}
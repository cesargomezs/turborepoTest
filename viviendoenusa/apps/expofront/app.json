{
  "expo": {
    "name": "Viviendo en USA",
    "slug": "viviendoenusa",
    "version": "1.0.0",
    "scheme": [
      "viviendoenusa",
      "com.googleusercontent.apps.1099132751870-9b7fb1f2vfv5v0enr3rkdn5r9p8sregk"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/backgroundusajpg.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/backgroundusajpg.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.viviendoenusa.expofront",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/backgroundusajpg.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.viviendoenusa.expofront"
    },
    "web": {
      "favicon": "./assets/images/backgroundusajpg.jpg",
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://viviendoenusa.app"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-notifications",
      "expo-sharing",
      "expo-apple-authentication",
      [
        "expo-file-system",
        {
          "photosPermission": "Permitir a Viviendo en USA acceder a tus fotos.",
          "savePhotosPermission": "Permitir a Viviendo en USA guardar fotos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/backgroundusajpg.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "486f501f-ae6e-484d-92ab-5a9c40319e6f"
      }
    }
  }
}